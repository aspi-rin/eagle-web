# ── 本地开发 ──────────────────────────────────────────────────────────────────
# 复制此文件为 backend/.env，设置 Eagle 图库的本地路径（Web UI 未保存时的默认值）。
EAGLE_LIBRARY=G:/Eagle

# ── Docker 部署 ───────────────────────────────────────────────────────────────
# 复制此文件为项目根目录的 .env，填写宿主机上 Eagle 图库的绝对路径。
# docker-compose 会将该路径以相同路径挂载到容器内，
# 因此 Web UI 中直接填写宿主机路径即可。
EAGLE_LIBRARY_PATH=/path/to/your/Eagle.library
